{
  "name": "storypress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/bundle.mjs && bash scripts/build.sh && node scripts/validate-artifact.mjs",
    "dev": "npm run build && node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "build:vercel": "node scripts/bundle.mjs --vercel",
    "check:vercel": "node scripts/check-vercel.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "0.523.0",
    "mediabunny": "^1.65.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.27.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "22.x"
  }
}
